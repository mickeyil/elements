#!/usr/bin/env python3
"""Self-bootstrapping launcher for elemctl.

Creates/manages a repo-local venv at local/venv with third-party deps.
Repo code (controller/, compiler/) is added to sys.path at runtime,
so the current checkout always runs regardless of which clone invokes this.
"""

import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

SCRIPT_PATH = str(Path(__file__).resolve())
REPO_ROOT = Path(SCRIPT_PATH).parent
VENV_DIR = REPO_ROOT / 'local' / 'venv'
VENV_PYTHON = VENV_DIR / 'bin' / 'python'
REQUIREMENTS = REPO_ROOT / 'requirements.txt'
STAMP_FILE = VENV_DIR / '.deps-stamp.json'
WEB_UI_DIR = REPO_ROOT / 'controller' / 'web_ui'
WEB_STAMP_FILE = REPO_ROOT / 'local' / '.web-deps-stamp.json'
BUILD_DIR = REPO_ROOT / 'build'

_USAGE = """\
usage: elemctl <command> [args]

commands:
  sim      launch a configured network simulator
  server   start controller server
  web      start web UI server and realtime viewer
  setup    install deps, build the web UI and native binaries (online)"""

_SUBCOMMANDS = {'sim', 'server', 'web', 'setup'}


def _inside_venv():
    """True if the current interpreter lives inside the managed venv."""
    try:
        Path(sys.prefix).resolve().relative_to(VENV_DIR.resolve())
        return True
    except ValueError:
        return False


def _current_stamp():
    """Compute stamp dict for current state."""
    req_hash = hashlib.sha256(REQUIREMENTS.read_bytes()).hexdigest()
    py_ver = f'{sys.version_info.major}.{sys.version_info.minor}'
    return {'python': py_ver, 'requirements_sha256': req_hash}


def _needs_install():
    """True if deps need (re)installing based on content hash + Python version."""
    if not STAMP_FILE.exists():
        return True
    try:
        saved = json.loads(STAMP_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        return True
    return saved != _current_stamp()


def _install_deps():
    """Run pip install and update the stamp file."""
    print('elemctl: installing dependencies...', file=sys.stderr)
    subprocess.run(
        [str(VENV_PYTHON), '-m', 'pip', 'install',
         '-r', str(REQUIREMENTS)],
        check=True,
    )
    STAMP_FILE.write_text(json.dumps(_current_stamp()))


def _run(cmd, *, cwd=None, tool=None):
    """Run a setup subprocess, turning the common failures (tool missing, build
    failed) into a clean exit instead of a traceback."""
    try:
        subprocess.run(cmd, cwd=cwd, check=True)
    except FileNotFoundError:
        print(f'elemctl: {tool or cmd[0]} is not installed or not on PATH',
              file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


def _web_deps_stamp():
    """Stamp the only expensive web step worth gating: the npm install."""
    lock = WEB_UI_DIR / 'package-lock.json'
    return {'package_lock_sha256': hashlib.sha256(lock.read_bytes()).hexdigest()}


def _needs_npm_install():
    if not (WEB_UI_DIR / 'node_modules').exists() or not WEB_STAMP_FILE.exists():
        return True
    try:
        return json.loads(WEB_STAMP_FILE.read_text()) != _web_deps_stamp()
    except (json.JSONDecodeError, OSError):
        return True


def _build_web():
    """Install web deps (only when package-lock changed) and build the UI into
    local/web_dist. The build itself is fast and always run, so the output is
    current for the checkout after setup; web.py refuses to serve if it's
    missing."""
    if _needs_npm_install():
        print('elemctl: installing web UI dependencies (npm ci)...', file=sys.stderr)
        _run(['npm', 'ci'], cwd=WEB_UI_DIR, tool='npm')
        WEB_STAMP_FILE.write_text(json.dumps(_web_deps_stamp()))
    print('elemctl: building web UI...', file=sys.stderr)
    _run(['npm', 'run', 'build'], cwd=WEB_UI_DIR, tool='npm')


def _build_native():
    """Configure and build the host runtime binary (sim_device) into build/.
    CMake tracks freshness, so re-running is cheap; the ~50 test executables are
    left for `make test` (we build only the sim_device target here)."""
    jobs = str(os.cpu_count() or 1)
    print('elemctl: building native sim_device...', file=sys.stderr)
    _run(['cmake', '-S', str(REPO_ROOT), '-B', str(BUILD_DIR)], tool='cmake')
    _run(['cmake', '--build', str(BUILD_DIR),
          '--target', 'sim_device', '--parallel', jobs], tool='cmake')


def _ensure_venv(force=False):
    """Create venv if needed, install deps if needed, then execv into it.

    Never returns — replaces the current process with the venv Python.
    """
    if not VENV_PYTHON.exists():
        print('elemctl: creating venv at', VENV_DIR, file=sys.stderr)
        subprocess.run(
            [sys.executable, '-m', 'venv', str(VENV_DIR)],
            check=True,
        )

    if force or _needs_install():
        _install_deps()

    env = os.environ.copy()
    if force:
        env['_ELEMCTL_SETUP_DONE'] = '1'
    os.execve(str(VENV_PYTHON), [str(VENV_PYTHON), SCRIPT_PATH, *sys.argv[1:]], env)


def main():
    if sys.version_info < (3, 10):
        print('elemctl: requires Python >= 3.10', file=sys.stderr)
        sys.exit(1)

    # Parse subcommand before any bootstrap
    sub = sys.argv[1] if len(sys.argv) > 1 else None

    if sub in (None, '--help', '-h'):
        print(_USAGE)
        sys.exit(0)

    if sub not in _SUBCOMMANDS:
        print(f'elemctl: unknown command: {sub}', file=sys.stderr)
        print(_USAGE, file=sys.stderr)
        sys.exit(1)

    # Bootstrap into managed venv if needed
    if not _inside_venv():
        _ensure_venv(force=(sub == 'setup'))
        # _ensure_venv never returns — after execv, _inside_venv() is True
        # and we skip straight to dispatch below

    # Inside venv — add repo code to sys.path
    controller_path = str(REPO_ROOT / 'controller')
    compiler_path = str(REPO_ROOT / 'compiler')
    for p in (compiler_path, controller_path):
        if p not in sys.path:
            sys.path.insert(0, p)

    # Pop subcommand so downstream argparse sees clean args
    del sys.argv[1]

    if sub == 'sim':
        from elemctl.sim import main as m
        m()
    elif sub == 'server':
        from elemctl.server import main as m
        m()
    elif sub == 'web':
        from elemctl.web import main as m
        m()
    elif sub == 'setup':
        if not os.environ.pop('_ELEMCTL_SETUP_DONE', None):
            _install_deps()
        _build_web()
        _build_native()
        print(f'elemctl: setup complete; ready to run from {REPO_ROOT}')


if __name__ == '__main__':
    main()
