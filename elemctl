#!/usr/bin/env python3
"""Self-bootstrapping launcher for elemctl.

Creates/manages a repo-local venv at local/venv with third-party deps.
Repo code (controller/, compiler/) is added to sys.path at runtime,
so the current checkout always runs regardless of which clone invokes this.
"""

import argparse
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

SCRIPT_PATH = str(Path(__file__).resolve())
REPO_ROOT = Path(SCRIPT_PATH).parent
VENV_DIR = REPO_ROOT / 'local' / 'venv'
VENV_PYTHON = VENV_DIR / 'bin' / 'python'
REQUIREMENTS = REPO_ROOT / 'requirements.txt'
STAMP_FILE = VENV_DIR / '.deps-stamp.json'
WEB_UI_DIR = REPO_ROOT / 'controller' / 'web_ui'
WEB_STAMP_FILE = REPO_ROOT / 'local' / '.web-deps-stamp.json'
BUILD_DIR = REPO_ROOT / 'build'

_USAGE = """\
usage: elemctl <command> [args]

commands:
  sim      launch a configured network simulator
  server   start controller server
  web      start web UI server and realtime viewer
  run      build, then start server and web with a joint log (ctrl-c stops both)
  setup    install deps, build the web UI, native binaries and firmware (online)"""

_SUBCOMMANDS = {'sim', 'server', 'web', 'run', 'setup'}


def _inside_venv():
    """True if the current interpreter lives inside the managed venv."""
    try:
        Path(sys.prefix).resolve().relative_to(VENV_DIR.resolve())
        return True
    except ValueError:
        return False


def _current_stamp():
    """Compute stamp dict for current state."""
    req_hash = hashlib.sha256(REQUIREMENTS.read_bytes()).hexdigest()
    py_ver = f'{sys.version_info.major}.{sys.version_info.minor}'
    return {'python': py_ver, 'requirements_sha256': req_hash}


def _needs_install():
    """True if deps need (re)installing based on content hash + Python version."""
    if not STAMP_FILE.exists():
        return True
    try:
        saved = json.loads(STAMP_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        return True
    return saved != _current_stamp()


def _install_deps():
    """Run pip install and update the stamp file."""
    print('elemctl: installing dependencies...', file=sys.stderr)
    subprocess.run(
        [str(VENV_PYTHON), '-m', 'pip', 'install',
         '-r', str(REQUIREMENTS)],
        check=True,
    )
    STAMP_FILE.write_text(json.dumps(_current_stamp()))


def _run(cmd, *, cwd=None, tool=None):
    """Run a setup subprocess, turning the common failures (tool missing, build
    failed) into a clean exit instead of a traceback."""
    try:
        subprocess.run(cmd, cwd=cwd, check=True)
    except FileNotFoundError:
        print(f'elemctl: {tool or cmd[0]} is not installed or not on PATH',
              file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


def _web_deps_stamp():
    """Stamp the only expensive web step worth gating: the npm install."""
    lock = WEB_UI_DIR / 'package-lock.json'
    return {'package_lock_sha256': hashlib.sha256(lock.read_bytes()).hexdigest()}


def _needs_npm_install():
    if not (WEB_UI_DIR / 'node_modules').exists() or not WEB_STAMP_FILE.exists():
        return True
    try:
        return json.loads(WEB_STAMP_FILE.read_text()) != _web_deps_stamp()
    except (json.JSONDecodeError, OSError):
        return True


def _build_web():
    """Install web deps (only when package-lock changed) and build the UI into
    local/web_dist. The build itself is fast and always run, so the output is
    current for the checkout after setup; web.py refuses to serve if it's
    missing."""
    if _needs_npm_install():
        print('elemctl: installing web UI dependencies (npm ci)...', file=sys.stderr)
        _run(['npm', 'ci'], cwd=WEB_UI_DIR, tool='npm')
        WEB_STAMP_FILE.write_text(json.dumps(_web_deps_stamp()))
    print('elemctl: building web UI...', file=sys.stderr)
    _run(['npm', 'run', 'build'], cwd=WEB_UI_DIR, tool='npm')


def _build_native():
    """Configure and build the host runtime binary (sim_device) into build/.
    CMake tracks freshness, so re-running is cheap; the ~50 test executables are
    left for `make test` (we build only the sim_device target here). Once
    configured, `cmake --build` reconfigures by itself when CMakeLists change."""
    jobs = str(os.cpu_count() or 1)
    print('elemctl: building native sim_device...', file=sys.stderr)
    if not (BUILD_DIR / 'CMakeCache.txt').exists():
        _run(['cmake', '-S', str(REPO_ROOT), '-B', str(BUILD_DIR)], tool='cmake')
    _run(['cmake', '--build', str(BUILD_DIR),
          '--target', 'sim_device', '--parallel', jobs], tool='cmake')


def _build_firmware():
    """Build the ESP32 firmware image (build/pio/esp32dev/firmware.bin) for OTA.
    Optional: only the hardware needs it, so without PlatformIO we skip it."""
    if shutil.which('pio') is None:
        print('elemctl: skipping firmware build; PlatformIO (pio) is not installed '
              '(the simulator does not need it)', file=sys.stderr)
        return
    print('elemctl: building firmware...', file=sys.stderr)
    _run(['pio', 'run', '-e', 'esp32dev'], cwd=REPO_ROOT, tool='pio')


def _build_all():
    _build_native()
    _build_web()
    _build_firmware()


class _Terminated(Exception):
    """Raised from our SIGTERM handler to leave the supervise loop."""


def _raise_terminated(signum, frame):
    raise _Terminated


def _pump_output(proc, tag, lock):
    """Copy one child's output to our stdout, one line at a time, tagged."""
    out = sys.stdout.buffer
    for line in proc.stdout:
        with lock:
            out.write(tag + line)
            out.flush()


def _stop_children(procs, grace=5.0):
    """Ask every still-running child to stop, then kill any that ignores us."""
    for p in procs.values():
        if p.poll() is None:
            p.send_signal(signal.SIGTERM)
    deadline = time.monotonic() + grace
    for p in procs.values():
        try:
            p.wait(timeout=max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()


def _run_all(argv):
    """`elemctl run`: build, then supervise `server` and `web` as children of
    one process.

    Their output is interleaved on our stdout with a [server]/[web] tag.
    Ctrl-C reaches all three processes at once (same process group), and each
    child already shuts down cleanly on SIGINT; we just wait for them. If one
    child exits on its own, the other is stopped and its exit code is ours.
    A SIGTERM sent to us alone stops both children too; if we die harder than
    that, the children get SIGTERM from the kernel (elemctl.procs).
    """
    parser = argparse.ArgumentParser(
        prog='elemctl run',
        description='Run the controller server and the web UI together')
    parser.add_argument('--config', default=None,
                        help='config JSON path (passed to both)')
    parser.add_argument('--socket', default=None,
                        help='controller unix socket path (passed to both)')
    parser.add_argument('--log-dir', default=None,
                        help='logs directory (passed to both)')
    parser.add_argument('--debug', action='store_true',
                        help='enable debug logging (server)')
    parser.add_argument('--host', default=None, help='HTTP bind host (web)')
    parser.add_argument('--port', default=None, help='HTTP port (web)')
    args = parser.parse_args(argv)

    _build_all()

    shared = []
    for opt in ('config', 'socket', 'log_dir'):
        value = getattr(args, opt)
        if value is not None:
            shared += ['--' + opt.replace('_', '-'), value]
    server_args = shared + (['--debug'] if args.debug else [])
    web_args = list(shared)
    if args.host is not None:
        web_args += ['--host', args.host]
    if args.port is not None:
        web_args += ['--port', args.port]

    from elemctl.procs import child_env
    env = child_env()
    env['PYTHONUNBUFFERED'] = '1'
    if sys.stdout.isatty():
        # Children write to a pipe, so let them know the far end is a terminal.
        env['ELEMCTL_FORCE_COLOR'] = '1'

    def spawn(sub, sub_args):
        return subprocess.Popen(
            [sys.executable, SCRIPT_PATH, sub, *sub_args],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)

    procs = {'server': spawn('server', server_args)}
    procs['web'] = spawn('web', web_args)

    lock = threading.Lock()
    width = max(len(n) for n in procs)
    pumps = [
        threading.Thread(target=_pump_output,
                         args=(p, f'[{n:<{width}}] '.encode(), lock),
                         daemon=True)
        for n, p in procs.items()
    ]
    for t in pumps:
        t.start()

    exit_code = 0
    signal.signal(signal.SIGTERM, _raise_terminated)
    try:
        while True:
            done = [n for n, p in procs.items() if p.poll() is not None]
            if done:
                name = done[0]
                exit_code = procs[name].returncode
                print(f'elemctl: {name} exited with code {exit_code}; stopping the rest',
                      file=sys.stderr)
                break
            time.sleep(0.2)
        _stop_children(procs)
    except KeyboardInterrupt:
        # The terminal already delivered SIGINT to the children; wait for them,
        # and on a second ctrl-c fall through to a hard kill.
        exit_code = 130
        try:
            _stop_children(procs)
        except KeyboardInterrupt:
            for p in procs.values():
                if p.poll() is None:
                    p.kill()
                    p.wait()
    except _Terminated:
        exit_code = 143
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        _stop_children(procs)
    for t in pumps:
        t.join(timeout=2.0)
    sys.exit(exit_code)


def _ensure_venv(force=False):
    """Create venv if needed, install deps if needed, then execv into it.

    Never returns — replaces the current process with the venv Python.
    """
    if not VENV_PYTHON.exists():
        print('elemctl: creating venv at', VENV_DIR, file=sys.stderr)
        subprocess.run(
            [sys.executable, '-m', 'venv', str(VENV_DIR)],
            check=True,
        )

    if force or _needs_install():
        _install_deps()

    env = os.environ.copy()
    if force:
        env['_ELEMCTL_SETUP_DONE'] = '1'
    os.execve(str(VENV_PYTHON), [str(VENV_PYTHON), SCRIPT_PATH, *sys.argv[1:]], env)


def main():
    if sys.version_info < (3, 10):
        print('elemctl: requires Python >= 3.10', file=sys.stderr)
        sys.exit(1)

    # Parse subcommand before any bootstrap
    sub = sys.argv[1] if len(sys.argv) > 1 else None

    if sub in (None, '--help', '-h'):
        print(_USAGE)
        sys.exit(0)

    if sub not in _SUBCOMMANDS:
        print(f'elemctl: unknown command: {sub}', file=sys.stderr)
        print(_USAGE, file=sys.stderr)
        sys.exit(1)

    # Bootstrap into managed venv if needed
    if not _inside_venv():
        _ensure_venv(force=(sub == 'setup'))
        # _ensure_venv never returns — after execv, _inside_venv() is True
        # and we skip straight to dispatch below

    # Inside venv — add repo code to sys.path
    controller_path = str(REPO_ROOT / 'controller')
    compiler_path = str(REPO_ROOT / 'compiler')
    for p in (compiler_path, controller_path):
        if p not in sys.path:
            sys.path.insert(0, p)

    # Pop subcommand so downstream argparse sees clean args
    del sys.argv[1]

    if sub == 'sim':
        from elemctl.sim import main as m
        m()
    elif sub == 'server':
        from elemctl.server import main as m
        m()
    elif sub == 'web':
        from elemctl.web import main as m
        m()
    elif sub == 'run':
        _run_all(sys.argv[1:])
    elif sub == 'setup':
        if not os.environ.pop('_ELEMCTL_SETUP_DONE', None):
            _install_deps()
        _build_all()
        print(f'elemctl: setup complete; ready to run from {REPO_ROOT}')


if __name__ == '__main__':
    main()
